# Painel InboxNexo Pro (Next.js / Vercel)
# Copie para .env.local em desenvolvimento. Na Vercel, cadastre em
# Project > Settings > Environment Variables, separando Development, Preview e Production.

# --- Público (pode ir ao navegador; nenhum segredo aqui) ---
NEXT_PUBLIC_APP_NAME=InboxNexo Pro
NEXT_PUBLIC_POLL_INTERVAL_MS=10000

# --- Servidor (nunca use o prefixo NEXT_PUBLIC_) ---
APP_URL=https://painel.inboxnexo.online
MAIL_DOMAIN=inboxnexo.online
MESSAGE_RETENTION_SECONDS=3600
APP_ENV=production
SUPABASE_URL=<SUPABASE_PROJECT_URL>
# Chave publicável: dado público, mas usada só pelo servidor neste projeto.
SUPABASE_PUBLISHABLE_KEY=<SUPABASE_PUBLISHABLE_KEY>
# SEGREDO: chave secreta/service role. Somente servidor, nunca no navegador.
SUPABASE_SECRET_KEY=<SUPABASE_SERVER_SECRET>
