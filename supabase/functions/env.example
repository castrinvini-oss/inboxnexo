# Segredos da Edge Function "ingest". Copie para supabase/functions/.env
# (ignorado pelo git) e NÃO versione o arquivo real.
# Produção: npx supabase secrets set --env-file supabase/functions/.env --project-ref <ref>
# (SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetados automaticamente pelo Supabase.)

# SEGREDO compartilhado com o Worker (mínimo 32 caracteres). Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
INGEST_HMAC_SECRET=<INGEST_HMAC_SECRET>

# Opcional, somente durante a rotação: segredo anterior aceito temporariamente.
INGEST_HMAC_SECRET_PREVIOUS=

# SEGREDO: chave secreta do projeto (sb_secret_...). Se ausente, a função usa
# SUPABASE_SERVICE_ROLE_KEY, injetada pelo Supabase.
INBOXNEXO_SERVER_SECRET=<SUPABASE_SERVER_SECRET>
